---
import { DemosGrid } from "./demos-grid";
---

<div class="max-w-4xl mx-auto p-8 space-y-16">
  <header class="space-y-4">
    <h1 class="text-4xl font-extrabold tracking-tight">Floating UI Demos</h1>
    <p class="text-xl text-slate-600 dark:text-slate-400">
      Recreating Floating UI website demos using <code>@floating-ui/dom</code> and
      React.
    </p>
  </header>

  <DemosGrid client:load />

  <footer
    class="pt-16 border-t border-slate-200 dark:border-slate-800 text-center text-slate-500 text-sm"
  >
    Inspired by Floating UI documentation.
  </footer>
</div>
