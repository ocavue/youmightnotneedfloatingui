---
import { BrowserFrame } from "./browser-frame";
---

<div class="flex flex-col gap-8 p-8 max-w-4xl mx-auto">
  <BrowserFrame title="Docs" client:load>
    <div class="p-6">
      <h1 class="text-2xl font-bold mb-4">Documentation</h1>
      <p class="text-slate-600 dark:text-slate-400">
        This is a browser frame with non-scrollable content.
      </p>
    </div>
  </BrowserFrame>

  <BrowserFrame title="Playground" scrollable="y" className="h-64" client:load>
    <div class="p-6">
      <h1 class="text-2xl font-bold mb-4">Scrolling Example</h1>
      <div class="space-y-4">
        {
          Array.from({ length: 10 }).map((_, i) => (
            <p key={i} class="text-slate-600 dark:text-slate-400">
              Line {i + 1}: Lorem ipsum dolor sit amet, consectetur adipiscing
              elit. Sed do eiusmod tempor incididunt ut labore et dolore magna
              aliqua.
            </p>
          ))
        }
      </div>
    </div>
  </BrowserFrame>
</div>

