---
import { PlacementDemo } from "./demos/placement-demo";
import { ShiftDemo } from "./demos/shift-demo";
import { FlipDemo } from "./demos/flip-demo";
import { SizeDemo } from "./demos/size-demo";
import { ArrowDemo } from "./demos/arrow-demo";
import { VirtualDemo } from "./demos/virtual-demo";
---

<div class="max-w-4xl mx-auto p-8 space-y-16">
  <header class="space-y-4">
    <h1 class="text-4xl font-extrabold tracking-tight">Floating UI Demos</h1>
    <p class="text-xl text-slate-600 dark:text-slate-400">
      Recreating Floating UI website demos using <code>@floating-ui/dom</code> and
      React.
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <PlacementDemo client:load />
    <ShiftDemo client:load />
    <FlipDemo client:load />
    <SizeDemo client:load />
    <ArrowDemo client:load />
    <VirtualDemo client:load />
  </div>

  <footer
    class="pt-16 border-t border-slate-200 dark:border-slate-800 text-center text-slate-500 text-sm"
  >
    Inspired by Floating UI documentation.
  </footer>
</div>
